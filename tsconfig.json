{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@testforgejs/*": ["./packages/*/src"]
    }
  },
  "include": ["packages/*/src", "vitest.config.ts"],
  "exclude": ["node_modules", "**/dist", "packages/**/test-d"]
}
