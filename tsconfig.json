{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@testforge/*": ["./packages/*/src"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/vue-test-core/tests",
    "vitest.config.ts",
    "__mocks__/**/*"
  ],
  "exclude": ["node_modules", "**/dist"]
}
