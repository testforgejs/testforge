{
  "name": "testforge-monorepo",
  "version": "0.0.1",
  "type": "module",
  "description": "The TestForge ecosystem — extensible component testing tools for Vue 3",
  "private": true,
  "scripts": {
    "build": "pnpm --filter \"./packages/**\" run build",
    "dev": "pnpm --filter \"./packages/**\" --parallel run dev",
    "test": "vitest run",
    "test:jest": "jest",
    "typecheck": "tsc --noEmit",
    "test:types": "pnpm --filter \"./packages/**\" --if-present test:types",
    "test:type-spec": "vitest --typecheck.only run",
    "check": "pnpm run test && pnpm run test:jest && pnpm run typecheck && pnpm run test:types && pnpm run test:type-spec",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "plugin:generate": "node scripts/scaffold-plugin.js",
    "docs:plugin": "node scripts/docs-plugins.js",
    "docs:all": "typedoc --options typedoc.workspace.json",
    "preinstall": "npx only-allow pnpm"
  },
  "keywords": [],
  "author": "Roman Levchenko",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^1.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@vue/test-utils": "^2.4.6",
    "babel-jest": "^30.3.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.9.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^16.4.0",
    "pinia": "^3.0.4",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.9",
    "tsd": "^0.33.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "~4.1.4",
    "vue": "^3.5.32",
    "vue-i18n": "^11.3.2",
    "vue-router": "^5.0.4",
    "vuetify": "^4.1.2"
  },
  "dependencies": {
    "happy-dom": "^20.9.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
