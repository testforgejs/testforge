{
  "name": "@testforgejs/vue-test-plugin-router",
  "version": "1.0.0-beta.0",
  "type": "module",
  "description": "Official TestForge plugin for Vue Router integration in component tests",
  "homepage": "https://github.com/testforgejs/testforge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/testforgejs/testforge.git",
    "directory": "packages/vue-test-plugin-router"
  },
  "bugs": {
    "url": "https://github.com/testforgejs/testforge/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test:types": "tsd",
    "docs:generate": "typedoc"
  },
  "keywords": [
    "vue",
    "vue3",
    "testing",
    "component-testing",
    "vue-test-utils",
    "vue-router",
    "router",
    "routing",
    "navigation",
    "testforge",
    "testforge-plugin"
  ],
  "license": "MIT",
  "author": "Roman Levchenko",
  "peerDependencies": {
    "vue-router": ">=4 <6",
    "@testforgejs/vue-test-core": "workspace:*"
  },
  "devDependencies": {
    "@testforgejs/vue-test-core": "workspace:*",
    "vue-router": "~5.1.0"
  }
}
