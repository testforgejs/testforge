{
  "name": "@testforge/vue-test-plugin-i18n",
  "version": "0.1.0",
  "type": "module",
  "description": "Official TestForge plugin for vue-i18n integration in component tests",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test:types": "tsd",
    "docs:generate": "typedoc"
  },
  "license": "MIT",
  "author": "Roman Levchenko",
  "peerDependencies": {
    "vue-i18n": ">=9 <12"
  },
  "dependencies": {
    "@testforge/vue-test-core": "workspace:*"
  }
}
