{
  "name": "@testforgejs/vue-test-plugin-primevue-v3",
  "version": "1.0.0-beta.3",
  "type": "module",
  "description": "Official TestForge plugin for PrimeVue 3 integration in component tests",
  "homepage": "https://github.com/testforgejs/testforge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/testforgejs/testforge.git",
    "directory": "packages/vue-test-plugin-primevue-v3"
  },
  "bugs": {
    "url": "https://github.com/testforgejs/testforge/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test:types": "tsd",
    "docs:generate": "typedoc"
  },
  "keywords": [
    "vue",
    "vue3",
    "testing",
    "component-testing",
    "vue-test-utils",
    "primevue",
    "testforge",
    "testforge-plugin"
  ],
  "license": "MIT",
  "author": "Roman Levchenko",
  "peerDependencies": {
    "@testforgejs/vue-test-core": "workspace:*",
    "primevue": "^3.0.0"
  },
  "devDependencies": {
    "@testforgejs/vue-test-core": "workspace:*",
    "primevue": "^3.0.0"
  },
  "testforge": {
    "plugin": {
      "schemaVersion": 1,
      "displayName": "PrimeVue 3"
    }
  }
}
