{
  "name": "@testforge/vue-test-plugin-primevue",
  "version": "0.0.1",
  "type": "module",
  "description": "Official TestForge plugin for PrimeVue integration in component tests",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test:types": "tsd",
    "docs:generate": "typedoc"
  },
  "keywords": [
    "vue",
    "vue3",
    "testing",
    "component-testing",
    "vue-test-utils",
    "primevue",
    "testforge",
    "testforge-plugin"
  ],
  "license": "MIT",
  "author": "Roman Levchenko",
  "peerDependencies": {
    "primevue": "^3.0.0 || ^4.0.0",
    "@testforge/vue-test-core": "workspace:*"
  },
  "devDependencies": {
    "primevue": "^4.0.0",
    "@testforge/vue-test-core": "workspace:*"
  }
}
