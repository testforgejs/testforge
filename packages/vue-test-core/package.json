{
  "name": "@testforge/vue-test-core",
  "version": "0.1.0",
  "type": "module",
  "description": "Core testing utilities and pipeline orchestration for the TestForge component testing framework",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test:types": "tsd"
  },
  "keywords": [
    "vue",
    "vue3",
    "testing",
    "component-testing",
    "vue-test-utils",
    "vitest",
    "jest",
    "testforge",
    "testing-framework",
    "component-test",
    "vue-testing"
  ],
  "license": "MIT",
  "author": "Roman Levchenko",
  "dependencies": {
    "vue-component-type-helpers": "^3.3.4"
  },
  "peerDependencies": {
    "@vue/test-utils": "^2.0.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "vue-router": "^5.0.0",
    "@testforge/vue-test-plugin-i18n": "workspace:*",
    "@testforge/vue-test-plugin-pinia": "workspace:*"
  },
  "tsd": {
    "directory": "test-d"
  }
}
