{
  "name": "@testforge/vue-test-preset-recommended",
  "version": "1.0.0-beta.0",
  "type": "module",
  "description": "Official recommended preset for getting started with the TestForge framework",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "keywords": [
    "vue",
    "vue3",
    "testing",
    "component-testing",
    "vue-test-utils",
    "preset",
    "configuration",
    "recommended",
    "testforge",
    "testforge-preset"
  ],
  "license": "MIT",
  "author": "Roman Levchenko",
  "dependencies": {
    "@testforge/vue-test-plugin-i18n": "workspace:*",
    "@testforge/vue-test-plugin-pinia": "workspace:*",
    "@testforge/vue-test-plugin-router": "workspace:*"
  },
  "peerDependencies": {
    "@testforge/vue-test-core": "workspace:*",
    "vue-router": ">=4 <6"
  },
  "devDependencies": {
    "@testforge/vue-test-core": "workspace:*",
    "vue-router": "^5.0.0"
  }
}
